FROM rocker/binder:4.4.1 AS base

ARG HOME=/home/rstudio

ENV HOME=$HOME

WORKDIR ${HOME}

USER root

ENV DEBIAN_FRONTEND=noninteractive \
    RENV_PATHS_ROOT=${HOME}/renv \
    RENV_PATHS_LIBRARY=${HOME}/renv/library \
    RENV_PATHS_CACHE=${HOME}/renv/.cache \
    RENV_CONFIG_REPOS_OVERRIDE=https://cloud.r-project.org \
    RENV_CONFIG_PAK_ENABLED=TRUE

RUN apt-get update \
    && apt-get install -y --no-install-recommends pandoc libsodium-dev graphviz libuv1-dev libjq-dev \
    libglpk-dev cmake libnng-dev libmbedtls-dev openssh-client liblzma-dev libpq-dev libcurl4-openssl-dev \
    libbz2-dev software-properties-common build-essential libmagic-dev libmagick++-dev curl g++ make \
    libharfbuzz-dev libfribidi-dev graphviz-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/downloaded_packages \
    && install2.r -e -n -1 --skipinstalled remotes \
    && R -e 'remotes::install_version("renv","1.0.7", repos = "https://cran.rstudio.com/")' \
    && R -e 'remotes::install_version("pak","0.7.2", repos = "https://cran.rstudio.com/")'

FROM base AS r_builder

COPY renv.lock .renvignore .Rprofile ./

COPY renv ${HOME}/renv

RUN mkdir -p $RENV_PATHS_LIBRARY \
    && mkdir -p $RENV_PATHS_CACHE \
    &&  R -e \
    "options(renv.config.pak.enabled=TRUE, renv.consent=TRUE); renv::restore()"

FROM base AS runtime

USER ${NB_USER}
RUN quarto install tinytex --no-prompt

RUN tinytex_bin="$(find "${HOME}/.TinyTeX/bin" -mindepth 1 -maxdepth 1 -type d -print -quit)" \
    && test -x "${tinytex_bin}/tlmgr" \
    && export PATH="${tinytex_bin}:${PATH}" \
    && tlmgr update --self --all \
    && tlmgr install koma-script selnolig nameref luatexbase caption \
    && luaotfload-tool --update --force
USER root

ENV R_LIBS=${HOME}/renv/library/R-4.4/x86_64-pc-linux-gnu \
    R_LIBS_SITE=${HOME}/renv/library/linux-ubuntu-jammy/R-4.4/x86_64-pc-linux-gnu

COPY --chown=${NB_USER}:${NB_USER} ./pages ${HOME}/pages

COPY --chown=${NB_USER}:${NB_USER} ./pipelines ${HOME}/pipelines

COPY --chown=${NB_USER}:${NB_USER} ./data/metadata ${HOME}/data/metadata

COPY --chown=${NB_USER}:${NB_USER} ./data/raw ${HOME}/data/raw

COPY --chown=${NB_USER}:${NB_USER} \
    README.md index.qmd _quarto.yml styles.css VERSION CITATION.cff LICENSE .lintr \
    ANNOUNCEMENTS.md CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md \
    ACCESSIBILITY.md SECURITY.md AI_POLICY.md bibliography.bib ${HOME}/

COPY --chown=${NB_USER}:${NB_USER} open-and-reproducible-science-in-r.Rproj .

COPY --chown=${NB_USER}:${NB_USER} .here .

COPY --from=r_builder --chown=${NB_USER}:${NB_USER} ${HOME} .

RUN echo '.libPaths(c("/home/rstudio/renv/library/linux-ubuntu-jammy/R-4.4/x86_64-pc-linux-gnu", .libPaths()))' \
    >> /usr/local/lib/R/etc/Rprofile.site

USER ${NB_USER}

ARG BUILD_DATE
ARG APP_VERSION
LABEL maintainer="j.bristow2@massey.ac.nz"
LABEL org.label-schema.build-date=$BUILD_DATE
LABEL version=$APP_VERSION
LABEL org.opencontainers.image.title="Binder for Open and Reproducible Science in R"
LABEL org.opencontainers.image.description="Binder image for Open and Reproducible Science in R workshop."
LABEL org.opencontainers.image.created=$BUILD_DATE
LABEL org.opencontainers.image.version=$APP_VERSION

EXPOSE 8787 8787
