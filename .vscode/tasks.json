{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "tasks": [
    {
      "label": "R: Check syntax",
      "type": "process",
      "command": "Rscript",
      "args": [
        "--vanilla",
        "${workspaceFolder}/.codex/scripts/check-r.R"
      ],
      "problemMatcher": [],
      "detail": "Parse maintained R scripts without executing code or project startup files."
    },
    {
      "label": "Quarto: Render book (all formats)",
      "type": "process",
      "command": "quarto",
      "args": [
        "render",
        "--to",
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Render the HTML website and the complete book PDF."
    },
    {
      "label": "Quarto: Render book (PDF)",
      "type": "process",
      "command": "quarto",
      "args": [
        "render",
        "--to",
        "pdf"
      ],
      "problemMatcher": [],
      "detail": "Render the complete book as a PDF; requires LaTeX such as TinyTeX."
    },
    {
      "label": "Quarto: Render book (HTML)",
      "type": "process",
      "command": "quarto",
      "args": [
        "render",
        "--to",
        "html"
      ],
      "problemMatcher": [],
      "detail": "Render the HTML book website using _quarto.yml."
    },
    {
      "label": "Quarto: Preview book (HTML)",
      "type": "process",
      "command": "quarto",
      "args": [
        "preview",
        "--to",
        "html",
        "--no-browser"
      ],
      "problemMatcher": [],
      "detail": "Preview the HTML book. Use Terminal: Terminate Task to stop it."
    },
    {
      "label": "Codex: Test project hooks",
      "type": "process",
      "command": "python3",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "${workspaceFolder}/.codex/tests",
        "-v"
      ],
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "${workspaceFolder}/.codex/tests",
          "-v"
        ]
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "Run the existing lifecycle hook tests in isolated temporary repositories."
    }
  ]
}
